# SwimNigeria Environment Variables Template
# Copy this file to .env.local for local development.
# WARNING: NEVER commit actual secrets or production keys to version control.

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="SwimNigeria"

# Supabase Configuration (Provisional Backend)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-placeholder

# Email Delivery (Provisional: Resend)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_placeholder
CONTACT_RECIPIENT_EMAIL=admin@swimnigeria.org

# Social & Direct Contact Links (Public)
NEXT_PUBLIC_WHATSAPP_NUMBER="+2348000000000"
NEXT_PUBLIC_INSTAGRAM_HANDLE="swimnigeria"
NEXT_PUBLIC_CONTACT_EMAIL="hello@swimnigeria.org"
